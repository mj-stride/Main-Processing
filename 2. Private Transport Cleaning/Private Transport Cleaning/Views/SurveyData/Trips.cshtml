@model List<PrivateTransportCleaning.Models.TripFile>

@{
    ViewData["Title"] = "Trips (Cleaned)";
    ViewData["Section"] = "Clean and Snap (Private)";

    // All routes render in the same color, matching the reference design.
    const string mapLineColor = "#1d4470";
}

<link rel="stylesheet" href="/css/shared.css" />
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<style>
    body.map-page,
    body.map-page .page-content,
    body.map-page main {
        overflow: hidden !important;
        height: 100vh !important;
        min-height: unset !important;
        flex: 1;
        min-height: 0;
    }

    .preview-view-wrapper {
        display: flex;
        flex-direction: column;
        height: calc(100vh - 120px);
        max-width: 1600px;
        margin: 0 auto;
        width: 100%;
        padding: 1rem 1.25rem;
        box-sizing: border-box;
    }

    .preview-body-grid {
        display: flex;
        gap: 1.5rem;
        flex: 1;
        min-height: 0;
        overflow: hidden;
    }

    .panel-left {
        width: 350px;
        flex-shrink: 0;
        background: var(--color-surface);
        border-radius: 12px;
        border: 1px solid var(--color-border);
        box-shadow: var(--shadow-sm);
        display: flex;
        flex-direction: column;
        overflow: hidden;
        max-height: 100%;
    }

    .panel-left-header {
        padding: 1rem 1.25rem 0.75rem;
        font-weight: 700;
        font-size: 0.95rem;
        color: var(--color-primary);
        border-bottom: 1px solid var(--color-border);
        background-color: var(--color-surface);
        flex-shrink: 0;
    }

    .selection-controls {
        display: flex;
        gap: 6px;
        padding: 0.65rem 1rem;
        border-bottom: 1px solid var(--color-border);
        background: var(--color-bg);
        flex-shrink: 0;
    }

    .btn-sel {
        font-size: 0.75rem;
        font-weight: 600;
        border-radius: 6px;
        padding: 4px 10px;
        border: 1px solid var(--color-border);
        background: var(--color-surface);
        color: var(--color-text-main);
        cursor: pointer;
        transition: all 0.15s ease;
    }

        .btn-sel:hover {
            background: var(--color-border);
        }

        .btn-sel.warning {
            color: #b45309;
            border-color: #fcd34d;
            background: #fffbeb;
        }

            .btn-sel.warning:hover {
                background: #fef3c7;
            }

    /* --- merge action bar --- */
    #mergeBar {
        display: none;
        align-items: center;
        gap: 8px;
        padding: 0.6rem 1rem;
        border-bottom: 1px solid var(--color-border);
        background: #eff6ff;
        font-size: 0.78rem;
        font-weight: 600;
        color: #1d4ed8;
        flex-shrink: 0;
    }

        #mergeBar .btn-sel {
            font-size: 0.72rem;
        }

    .btn-merge-go {
        background-color: #1d4ed8 !important;
        color: #fff !important;
        border-color: #1d4ed8 !important;
    }

        .btn-merge-go:disabled {
            opacity: 0.45;
            cursor: not-allowed;
        }

    .trip-list-scroll {
        flex: 1 1 0;
        overflow-y: auto;
        min-height: 0;
        padding: 0.75rem 1rem;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

        .trip-list-scroll::-webkit-scrollbar {
            width: 6px;
        }

        .trip-list-scroll::-webkit-scrollbar-track {
            background: var(--color-bg);
        }

        .trip-list-scroll::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 999px;
        }

    .trip-row {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        background: var(--color-bg);
        border: 1px solid var(--color-border);
        border-radius: 8px;
        padding: 8px 10px;
        transition: all 0.15s ease;
    }

        .trip-row:hover {
            background: #f1f5f9;
            border-color: #cbd5e1;
        }

        .trip-row input[type="checkbox"] {
            accent-color: var(--color-primary);
            margin-top: 4px;
            cursor: pointer;
            width: 15px;
            height: 15px;
            flex-shrink: 0;
        }

        /* row is picked-for-merge state aware */
        .trip-row.row-picked {
            background: #eff6ff;
            border-color: #93c5fd;
        }

    .trip-row-body {
        flex: 1;
        min-width: 0;
        cursor: pointer;
    }

    .trip-row-title {
        font-size: 0.8rem;
        font-weight: 700;
        color: var(--color-primary);
        line-height: 1.2;
        word-break: break-all;
    }

    .trip-row-meta {
        font-size: 0.72rem;
        color: var(--color-text-muted);
        line-height: 1.35;
        margin-top: 2px;
    }

    .trip-row-actions {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
        margin-top: 4px;
    }

    .btn-mini {
        font-size: 0.7rem;
        font-weight: 600;
        border-radius: 999px;
        padding: 3px 10px;
        text-decoration: none;
        border: 1px solid var(--color-primary);
        color: var(--color-primary);
        background: transparent;
        transition: all 0.15s;
        cursor: pointer;
    }

        .btn-mini:hover {
            background: var(--color-primary);
            color: #ffffff;
        }

        .btn-mini.secondary {
            border-color: #bbbbbb;
            color: #555555;
        }

            .btn-mini.secondary:hover {
                background: #555555;
                color: #ffffff;
            }

    /* --- MERGED-SOURCE BADGE --- */
    .badge-merged {
        display: inline-flex;
        align-items: center;
        gap: 2px;
        font-size: 0.66rem;
        font-weight: 700;
        color: #7c3aed;
        background: #f3e8ff;
        border-radius: 4px;
        padding: 1px 6px;
        margin-left: 6px;
        vertical-align: middle;
    }

    /* merge-pick toggle button */
    .btn-merge-pick {
        flex-shrink: 0;
        width: 26px;
        height: 26px;
        border-radius: 999px;
        border: 1px solid var(--color-border);
        background: var(--color-surface);
        color: #94a3b8;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.15s ease;
        font-size: 0.85rem;
        margin-top: 1px;
    }

        .btn-merge-pick:hover {
            border-color: var(--color-primary);
            color: var(--color-primary);
        }

        .btn-merge-pick.active {
            background: #1d4ed8;
            border-color: #1d4ed8;
            color: #fff;
        }

    .panel-left-actions {
        padding: 1rem;
        border-top: 1px solid var(--color-border);
        background: var(--color-surface);
        flex-shrink: 0;
    }

    .btn-ttds-success {
        background-color: #16a34a !important;
        border-color: #16a34a !important;
    }

        .btn-ttds-success:hover {
            background-color: #15803d !important;
        }

    .panel-right {
        flex: 1;
        min-width: 0;
        background: var(--color-surface);
        border-radius: 12px;
        border: 1px solid var(--color-border);
        box-shadow: var(--shadow-sm);
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    #map {
        flex: 1;
        min-height: 0;
        width: 100%;
        background-color: #e5e7eb;
    }

    .map-footer {
        padding: 0.75rem 1.25rem;
        font-size: 0.82rem;
        color: var(--color-text-muted);
        border-top: 1px solid var(--color-border);
        background: var(--color-surface);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-shrink: 0;
    }

    form {
        display: flex;
        flex-direction: column;
        flex: 1;
        min-height: 0;
    }
</style>

<div class="preview-view-wrapper">

    <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3 pb-3 border-bottom flex-shrink-0"
         style="border-color: var(--color-border) !important;">
        <div>
            <h1 class="fw-bold mb-1 d-flex align-items-center gap-2"
                style="font-size: 1.75rem; color: var(--color-text-main);">
                <i class="bi bi-check2-circle" style="color: var(--color-accent);"></i>
                Cleaned Trips Only
            </h1>
            <div class="d-flex align-items-center gap-2"
                 style="font-size: 0.85rem; color: var(--color-text-muted);">
                <span>@Model.Count trip@(Model.Count != 1 ? "s" : "") processed</span>
            </div>
        </div>

        <a href="/SurveyData/Index" class="btn-action">
            <i class="bi bi-arrow-left"></i> Back to Uploads
        </a>
    </div>

    <div class="preview-body-grid pt-2">

        <div class="panel-left">
            <div class="panel-left-header">
                <i class="bi bi-signpost-split-fill me-2"></i>Trips (Cleaned)
            </div>

            <div class="selection-controls">
                <button type="button" class="btn-sel" id="selectAllBtn">
                    <i class="bi bi-check-all me-1"></i>All
                </button>
                <button type="button" class="btn-sel" id="deselectAllBtn">
                    <i class="bi bi-x me-1"></i>None
                </button>
                <button type="button" class="btn-sel warning ms-auto" id="toggleBtn">
                    <i class="bi bi-arrow-left-right me-1"></i>Toggle
                </button>
            </div>

            <div id="mergeBar">
                <i class="bi bi-link-45deg"></i>
                <span><span id="mergeCount">0</span> selected to merge</span>
                <button type="button" class="btn-sel btn-merge-go ms-auto" id="btnMergeGo" disabled>
                    <i class="bi bi-magic me-1"></i>Merge into One Trip
                </button>
                <button type="button" class="btn-sel" id="btnMergeClear">Clear</button>
            </div>

            <form id="downloadForm" method="post" asp-action="DownloadSelected">
                <div class="trip-list-scroll">
                    @{
                        int __idx = 0;
                    }
                    @foreach (var file in Model)
                    {
                        var __id = "chk_" + __idx;
                        var __title = file.FileName != null
                            ? file.FileName.Replace("_snapped.csv", "").Replace(".csv", "")
                            : "Unknown";
                        var __isMerged = file.FileName != null &&
                            file.FileName.ToUpperInvariant().Contains("MERGED");
                        var __sizeStr = file.FileSize > 0
                            ? (file.FileSize / 1024.0).ToString("0.00") + " KB"
                            : "Unknown size";
                        __idx++;

                        <div class="trip-row" data-tripkey="@file.FileName">
                            <input class="trip-checkbox"
                                   type="checkbox"
                                   id="@__id"
                                   name="files"
                                   value="@file.FileName"
                                   data-title="@__title"
                                   checked
                                   onchange="toggleTripOnMap(this)" />

                            <label class="trip-row-body" for="@__id">
                                <div class="trip-row-title">
                                    @__title
                                    @if (__isMerged)
                                    {
                                        <span class="badge-merged"><i class="bi bi-link-45deg"></i>Merged Files</span>
                                    }
                                </div>
                                <div class="trip-row-meta">
                                    <i class="bi bi-file-earmark me-1"></i> @__sizeStr
                                </div>
                                <div class="trip-row-actions">
                                    <a class="btn-mini"
                                       href="javascript:void(0)"
                                       data-file="@file.FileName"
                                       onclick="focusTrip(this); event.stopPropagation();">
                                        <i class="bi bi-map me-1"></i>View Map
                                    </a>
                                    <a class="btn-mini secondary" href="@file.DownloadUrl"
                                       onclick="event.stopPropagation();">
                                        <i class="bi bi-download me-1"></i>Download
                                    </a>
                                </div>
                            </label>

                            <button type="button" class="btn-merge-pick" data-tripkey="@file.FileName"
                                    title="Pick this trip to merge with another">
                                <i class="bi bi-link-45deg"></i>
                            </button>
                        </div>
                    }
                </div>

                <div class="panel-left-actions">
                    <button class="btn-ttds btn-ttds-success w-100 d-flex align-items-center justify-content-center gap-2"
                            type="submit">
                        <i class="bi bi-download"></i> Download CSV ZIP
                    </button>
                </div>
            </form>
        </div>

        <div class="panel-right">
            <div id="map"></div>
            <div class="map-footer">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-info-circle-fill" style="color: var(--color-primary);"></i>
                    <span>
                        Click a path to hide it. <strong style="color: #16a34a;">Green</strong> = Origin,
                        <strong style="color: #dc2626;">Red</strong> = Destination.
                    </span>
                </div>
                <a id="btnNext"
                   asp-action="GoToMainProc"
                   class="btn-topbar ms-auto px-4"
                   style="text-decoration:none; opacity:.4; pointer-events:none; cursor:not-allowed;">
                    Next: Processing
                    <i class="bi bi-arrow-right-circle-fill ms-1"></i>
                </a>
            </div>
        </div>

    </div>
</div>

<script>
    document.body.classList.add('map-page');

    const map = L.map('map').setView([12.8797, 121.7740], 6);

    requestAnimationFrame(() => {
        map.invalidateSize();
    });

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 20
    }).addTo(map);

    setTimeout(() => {
        map.invalidateSize();
    }, 100);

    window.addEventListener('resize', () => map.invalidateSize());

    // All routes render in this single color, matching the reference design.
    const TRIP_COLOR = '#1d4470';

    // file name -> { layer, startMarker, endMarker }
    const loadedTrips = {};

    function getBoxes() {
        return document.querySelectorAll(".trip-checkbox");
    }

    function fitToLoadedTrips() {
        const layers = Object.values(loadedTrips).map(t => t.layer);
        if (layers.length === 0) return;

        const group = L.featureGroup(layers);
        map.fitBounds(group.getBounds(), { padding: [20, 20] });
    }

    function loadAndAddTrip(file, color, title) {
        if (loadedTrips[file]) return;

        fetch('/SurveyData/GetTripData?file=' + encodeURIComponent(file))
            .then(r => r.json())
            .then(points => {
                if (!points || points.length < 2) return;

                const latlngs = points.map(p => [p[0], p[1]]);

                const layer = L.polyline(latlngs, {
                    color: color,
                    weight: 4,
                    opacity: 0.85
                }).addTo(map);

                layer.bindPopup(`<strong style="color:${color};">${title}</strong>`);

                // Clicking a path hides that trip without touching any others.
                layer.on("click", () => {
                    const cb = document.querySelector(`.trip-checkbox[value="${CSS.escape(file)}"]`);
                    if (cb) {
                        cb.checked = false;
                        toggleTripOnMap(cb);
                    }
                });

                const startMarker = L.circleMarker(latlngs[0], {
                    radius: 6,
                    color: '#16a34a',
                    fillColor: '#16a34a',
                    fillOpacity: 1
                }).addTo(map).bindPopup(`<strong>Origin</strong><br/>${title}`);

                const endMarker = L.circleMarker(latlngs[latlngs.length - 1], {
                    radius: 6,
                    color: '#dc2626',
                    fillColor: '#dc2626',
                    fillOpacity: 1
                }).addTo(map).bindPopup(`<strong>Destination</strong><br/>${title}`);

                loadedTrips[file] = { layer, startMarker, endMarker };

                fitToLoadedTrips();
            });
    }

    function removeTrip(file) {
        const entry = loadedTrips[file];
        if (!entry) return;

        map.removeLayer(entry.layer);
        map.removeLayer(entry.startMarker);
        map.removeLayer(entry.endMarker);

        delete loadedTrips[file];

        fitToLoadedTrips();
    }

    function toggleTripOnMap(checkbox) {
        const file = checkbox.value;
        const title = checkbox.getAttribute('data-title') || file;

        if (checkbox.checked) {
            loadAndAddTrip(file, TRIP_COLOR, title);
        } else {
            removeTrip(file);
        }
    }

    function focusTrip(el) {
        const file = el.getAttribute("data-file");
        const checkbox = document.querySelector(`.trip-checkbox[value="${CSS.escape(file)}"]`);

        if (checkbox && !checkbox.checked) {
            checkbox.checked = true;
            toggleTripOnMap(checkbox);
        }

        const tryFocus = () => {
            const entry = loadedTrips[file];
            if (entry) {
                map.fitBounds(entry.layer.getBounds(), { padding: [20, 20] });
                return true;
            }
            return false;
        };

        if (!tryFocus()) {
            setTimeout(tryFocus, 400);
        }
    }

    function enableNext() {
        const btn = document.getElementById("btnNext");
        if (!btn) return;

        btn.style.opacity = "1";
        btn.style.pointerEvents = "auto";
        btn.style.cursor = "pointer";
    }

    document.getElementById("selectAllBtn").addEventListener("click", () => {
        getBoxes().forEach(c => { if (!c.checked) { c.checked = true; toggleTripOnMap(c); } });
    });

    document.getElementById("deselectAllBtn").addEventListener("click", () => {
        getBoxes().forEach(c => { if (c.checked) { c.checked = false; toggleTripOnMap(c); } });
    });

    document.getElementById("toggleBtn").addEventListener("click", () => {
        getBoxes().forEach(c => { c.checked = !c.checked; toggleTripOnMap(c); });
    });

    /* =========================================================
       MERGE PICKER — independent of the map/download checkboxes.
       Pick two or more trips, then merge them into one new CSV.
       ========================================================= */
    (function () {
        const mergeState = new Set();
        const mergeBar = document.getElementById("mergeBar");
        const mergeCountEl = document.getElementById("mergeCount");
        const btnMergeGo = document.getElementById("btnMergeGo");
        const btnMergeClear = document.getElementById("btnMergeClear");

        function refreshMergeBar() {
            const n = mergeState.size;
            mergeBar.style.display = n > 0 ? "flex" : "none";
            mergeCountEl.textContent = n;
            btnMergeGo.disabled = n < 2;
        }

        document.querySelectorAll(".btn-merge-pick").forEach(btn => {
            btn.addEventListener("click", () => {
                const key = btn.dataset.tripkey;
                const row = btn.closest(".trip-row");

                if (mergeState.has(key)) {
                    mergeState.delete(key);
                    btn.classList.remove("active");
                    row.classList.remove("row-picked");
                } else {
                    mergeState.add(key);
                    btn.classList.add("active");
                    row.classList.add("row-picked");
                }

                refreshMergeBar();
            });
        });

        btnMergeClear.addEventListener("click", () => {
            mergeState.clear();
            document.querySelectorAll(".btn-merge-pick.active").forEach(b => b.classList.remove("active"));
            document.querySelectorAll(".trip-row.row-picked").forEach(r => r.classList.remove("row-picked"));
            refreshMergeBar();
        });

        btnMergeGo.addEventListener("click", () => {
            if (mergeState.size < 2) return;

            const titles = Array.from(mergeState).map(key => {
                const row = document.querySelector(`.trip-row[data-tripkey="${CSS.escape(key)}"]`);
                return row ? row.querySelector(".trip-row-title").textContent.trim() : key;
            });

            // UPDATED CONFIRMATION TEXT TO STATE FILES WILL BE DELETED
            const ok = confirm(
                "Merge these " + mergeState.size + " trips into a single continuous trip?\n\n" +
                titles.map(t => "\u2022 " + t).join("\n") +
                "\n\nPoints will be combined and re-sorted by timestamp. " +
                "This creates a new merged CSV and deletes the separate original files."
            );
            if (!ok) return;

            const originalHtml = btnMergeGo.innerHTML;
            btnMergeGo.disabled = true;
            btnMergeGo.innerHTML = '<i class="bi bi-hourglass-split"></i> Merging...';

            const formData = new FormData();
            mergeState.forEach(f => formData.append("files", f));

            fetch('/SurveyData/MergeSelected', {
                method: 'POST',
                body: formData
            })
                .then(r => r.json())
                .then(data => {
                    if (data.success) {
                        window.location.href = data.redirect;
                    } else {
                        alert(data.message || "Merge failed.");
                        btnMergeGo.disabled = mergeState.size < 2;
                        btnMergeGo.innerHTML = originalHtml;
                    }
                })
                .catch(() => {
                    alert("Merge request failed.");
                    btnMergeGo.disabled = mergeState.size < 2;
                    btnMergeGo.innerHTML = originalHtml;
                });
        });
    })();

    document.addEventListener("DOMContentLoaded", function () {
        const form = document.getElementById("downloadForm");

        if (form) {
            form.addEventListener("submit", function () {
                enableNext();
            });
        }

        // Trips start checked by default, so draw all of them on load.
        getBoxes().forEach(c => {
            if (c.checked) toggleTripOnMap(c);
        });
    });
</script>